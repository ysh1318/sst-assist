{
  "manifest_version": 3,
  "name": "SST Assist",
  "version": "1.0.0",
  "description": "Socratic AI study companion and problem walkthrough assistant for Scaler Academy students.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://www.scaler.com/*",
    "*://*.scaler.com/*",
    "https://api.groq.com/*",
    "https://*.workers.dev/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open SST Assist",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Toggle SST Assist Side Panel"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.scaler.com/*"
      ],
      "js": [
        "content/extractor.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
